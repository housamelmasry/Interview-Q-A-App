{
  "openapi": "3.0.3",
  "info": {
    "title": "Arabic Interview Guide API",
    "version": "1.0.0",
    "description": "REST API backing the Arabic Interview Guide, a full-stack technical interview preparation app. Questions are grouped into categories and each question owns one or more answers.\n\nAll data is served from a local SQLite database. **This API has no authentication** - it is intended for local development and demonstration.",
    "license": { "name": "MIT", "url": "https://opensource.org/licenses/MIT" }
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Local development" }
  ],
  "tags": [
    { "name": "System", "description": "Health and discovery" },
    { "name": "Categories", "description": "Guide sections and their display metadata" },
    { "name": "Questions", "description": "Interview questions and their nested answers" },
    { "name": "Answers", "description": "Answers belonging to a single question" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check",
        "description": "Returns OK when the API is reachable. Useful for container health probes and uptime checks.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": { "status": "OK" }
              }
            }
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "List categories",
        "description": "Returns every category ordered alphabetically by label.",
        "responses": {
          "200": {
            "description": "List of categories",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Categories"],
        "summary": "Create a category",
        "description": "The `id` is a caller-supplied slug and is not auto-generated, so it can be used as a stable route segment.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CategoryInput" },
              "example": { "id": "devops", "label": "DevOps", "icon": "⚙️", "color": "#00B8D9" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Category created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageWithId" },
                "example": { "id": "devops", "message": "Category added successfully" }
              }
            }
          },
          "400": {
            "description": "`id` or `label` missing",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Category ID and label are required" }
              }
            }
          },
          "500": {
            "description": "Database error, e.g. a duplicate `id`",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/categories/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "example": "devops" }
      ],
      "put": {
        "tags": ["Categories"],
        "summary": "Update a category",
        "description": "The `id` is immutable; it is matched from the URL. Omitted `icon` or `color` fields fall back to `\"\"` and `\"#666666\"` respectively.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CategoryInput" },
              "example": { "label": "DevOps & SRE", "icon": "⚙️", "color": "#00B8D9" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Category updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "Category updated successfully" }
              }
            }
          },
          "400": {
            "description": "`label` missing",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "No category with that id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Category not found" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Categories"],
        "summary": "Delete a category",
        "description": "Cascades: every question in the category and every answer on those questions is deleted too. This is enforced by `ON DELETE CASCADE` foreign keys.",
        "responses": {
          "200": {
            "description": "Category and its dependent records deleted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "Category deleted successfully" }
              }
            }
          },
          "404": {
            "description": "No category with that id",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/questions": {
      "get": {
        "tags": ["Questions"],
        "summary": "List questions with their answers",
        "description": "Returns a single flat join of questions, categories and answers, grouped server-side so each question carries a nested `answers` array. Answers are ordered oldest first.",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Restrict results to one category id.",
            "schema": { "type": "string" },
            "example": "laravel-core"
          }
        ],
        "responses": {
          "200": {
            "description": "Questions, each with its category metadata and answers",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/QuestionWithAnswers" } },
                "example": [
                  {
                    "id": 1,
                    "question_text": "What is the service container and how does dependency injection work?",
                    "category_id": "laravel-core",
                    "category_label": "Laravel Core",
                    "icon": "🔴",
                    "color": "#FF4444",
                    "answers": [
                      { "id": 1, "answer_text": "The container binds class names to concrete instances." }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Questions"],
        "summary": "Create a question, optionally with answers",
        "description": "The question and its answers are inserted inside a single transaction. If any answer insert fails the whole question is rolled back, so a question is never persisted with partial answers. Accepts answers as plain strings or as objects with an `answer_text` field.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/QuestionInput" },
              "example": {
                "category_id": "laravel-core",
                "question_text": "Explain the service container.",
                "answers": ["It resolves and injects dependencies.", "Bindings are registered in a service provider."]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Question created, with the new id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageWithId" },
                "example": { "id": 62, "message": "Question and answers added successfully" }
              }
            }
          },
          "400": {
            "description": "`category_id` or `question_text` missing",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Category ID and question text are required" }
              }
            }
          },
          "500": {
            "description": "Database error, e.g. an unknown `category_id`",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/questions/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
      ],
      "put": {
        "tags": ["Questions"],
        "summary": "Update a question and its answers",
        "description": "When `answers` is present the existing answers are deleted and the supplied list is inserted instead, inside one transaction. The `answers` array is therefore the full desired end state, not a patch. Omitting `answers` updates the question text and category only and leaves existing answers untouched.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/QuestionUpdateInput" },
              "example": {
                "question_text": "Explain the service container.",
                "category_id": "laravel-advanced",
                "answers": ["Updated answer text."]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Question updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "Question and answers updated successfully" }
              }
            }
          },
          "404": {
            "description": "No question with that id",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "delete": {
        "tags": ["Questions"],
        "summary": "Delete a question",
        "description": "Cascades to the question's answers.",
        "responses": {
          "200": {
            "description": "Question and its answers deleted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "Question deleted successfully" }
              }
            }
          },
          "404": {
            "description": "No question with that id",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/answers/{questionId}": {
      "get": {
        "tags": ["Answers"],
        "summary": "List answers for a question",
        "description": "Returns raw answer rows ordered by id. The question list endpoint already nests answers, so this is mainly a direct-access convenience route.",
        "parameters": [
          { "name": "questionId", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": {
            "description": "Answers belonging to the question",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Answer" } }
              }
            }
          }
        }
      }
    },
    "/api/answers/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }
      ],
      "put": {
        "tags": ["Answers"],
        "summary": "Update a single answer",
        "description": "Updates one answer row in isolation, without touching sibling answers.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["answer_text"], "properties": { "answer_text": { "type": "string" } } },
              "example": { "answer_text": "Refined answer explanation." }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "Answer updated successfully" }
              }
            }
          },
          "404": {
            "description": "No answer with that id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Answer not found" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Answers"],
        "summary": "Delete a single answer",
        "responses": {
          "200": {
            "description": "Answer deleted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "Answer deleted successfully" }
              }
            }
          },
          "404": {
            "description": "No answer with that id",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Caller-supplied slug used as the primary key.", "example": "laravel-core" },
          "label": { "type": "string", "description": "Display name shown on the tab.", "example": "Laravel Core" },
          "icon": { "type": "string", "description": "Emoji rendered beside the label.", "example": "🔴" },
          "color": { "type": "string", "description": "Hex colour used for the active tab, counters and answer borders.", "example": "#FF4444" }
        }
      },
      "CategoryInput": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "id": { "type": "string", "description": "Required on create, ignored on update.", "example": "devops" },
          "label": { "type": "string", "example": "DevOps" },
          "icon": { "type": "string", "example": "⚙️" },
          "color": { "type": "string", "example": "#00B8D9" }
        }
      },
      "QuestionWithAnswers": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "question_text": { "type": "string", "example": "What is the service container?" },
          "category_id": { "type": "string", "example": "laravel-core" },
          "category_label": { "type": "string", "description": "Denormalised from the join so the UI can label search results without a second request.", "example": "Laravel Core" },
          "icon": { "type": "string", "example": "🔴" },
          "color": { "type": "string", "example": "#FF4444" },
          "answers": { "type": "array", "items": { "$ref": "#/components/schemas/Answer" } }
        }
      },
      "QuestionInput": {
        "type": "object",
        "required": ["category_id", "question_text"],
        "properties": {
          "category_id": { "type": "string", "example": "laravel-core" },
          "question_text": { "type": "string", "example": "Explain the service container." },
          "answers": {
            "type": "array",
            "description": "Optional. Each item may be a plain string or an object with `answer_text`.",
            "items": { "oneOf": [{ "type": "string" }, { "$ref": "#/components/schemas/Answer" }] }
          }
        }
      },
      "QuestionUpdateInput": {
        "type": "object",
        "properties": {
          "question_text": { "type": "string" },
          "category_id": { "type": "string" },
          "answers": {
            "type": "array",
            "description": "When present, replaces all existing answers for the question.",
            "items": { "oneOf": [{ "type": "string" }, { "$ref": "#/components/schemas/Answer" }] }
          }
        }
      },
      "Answer": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "question_id": { "type": "integer", "description": "Present on the direct answers route; omitted from the nested question payload.", "example": 1 },
          "answer_text": { "type": "string", "description": "Rendered with preserved line breaks, so multi-line code examples keep their formatting.", "example": "First line.\nSecond line." }
        }
      },
      "Message": {
        "type": "object",
        "properties": { "message": { "type": "string", "example": "Question deleted successfully" } }
      },
      "MessageWithId": {
        "type": "object",
        "properties": {
          "id": { "oneOf": [{ "type": "integer" }, { "type": "string" }], "example": 62 },
          "message": { "type": "string", "example": "Question added successfully" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": { "status": { "type": "string", "example": "OK" } }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string", "example": "Category not found" } }
      }
    }
  }
}
